{
  "name": "rice-pot-playwright-advance-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Playwright and TypeScript framework for Salesforce login",
  "scripts": {
    "test": "playwright test",
    "test:valid": "playwright test tests/login-valid.spec.ts",
    "test:invalid": "playwright test tests/login-invalid.spec.ts",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "dotenv": "^16.6.1",
    "typescript": "^5.9.3"
  }
}
