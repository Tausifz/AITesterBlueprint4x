{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "plan.json",
  "type": "object",
  "required": ["jira_id", "title", "test_cases", "traceability"],
  "properties": {
    "jira_id": { "type": "string" },
    "title": { "type": "string" },
    "objective": { "type": "string" },
    "scope": {
      "type": "object",
      "properties": {
        "in": { "type": "array", "items": { "type": "string" } },
        "out": { "type": "array", "items": { "type": "string" } }
      }
    },
    "strategy": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "approach": { "type": "string" },
          "justified_by": { "type": "string" }
        },
        "required": ["type", "justified_by"]
      }
    },
    "risk_assessment": { "type": "array" },
    "environment_and_data": { "type": "object" },
    "entry_criteria": { "type": "array" },
    "exit_criteria": { "type": "array" },
    "test_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "requirement_id", "title", "type", "priority"],
        "properties": {
          "id": { "type": "string" },
          "requirement_id": { "type": "string" },
          "title": { "type": "string" },
          "type": { "type": "string" },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "preconditions": { "type": "array", "items": { "type": "string" } },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "action": { "type": "string" },
                "expected": { "type": "string" }
              },
              "required": ["action", "expected"]
            }
          },
          "test_data": { "type": "object" },
          "automation_candidate": { "type": "boolean" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "source_field": { "type": "string" },
          "assumption": { "type": ["string", "null"] }
        }
      }
    },
    "traceability": {
      "type": "object",
      "properties": {
        "matrix": { "type": "array" },
        "uncovered_requirements": { "type": "array" }
      }
    },
    "automation_backlog": { "type": "array" },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array" },
    "open_questions": { "type": "array" }
  }
}
