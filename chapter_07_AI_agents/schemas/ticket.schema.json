{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ticket.json",
  "type": "object",
  "required": ["key", "summary", "description_markdown", "issuetype"],
  "properties": {
    "key": { "type": "string" },
    "summary": { "type": "string" },
    "description_markdown": { "type": "string" },
    "issuetype": { "type": "string" },
    "status": { "type": "string" },
    "priority": { "type": "string" },
    "labels": { "type": "array", "items": { "type": "string" } },
    "components": { "type": "array", "items": { "type": "string" } },
    "fix_versions": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
    "ac_source": { "type": "string", "enum": ["customfield", "description", "comment", "none"] },
    "comments": { "type": "array" },
    "linked_issues": { "type": "array" },
    "subtasks": { "type": "array" },
    "attachments": { "type": "array" },
    "parent": { "type": ["string", "null"] },
    "epic": { "type": ["string", "null"] },
    "sprint_end_date": { "type": ["string", "null"] }
  }
}
